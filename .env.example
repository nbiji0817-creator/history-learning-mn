# ============================================================================
# ТҮҮХЭЭ МЭДЬЕ — Орчны хувьсагчид
#
# Энэ файлыг .env.local нэрээр хуулж аваад утгуудаа бөглөнө үү:
#   cp .env.example .env.local
#
# ⚠️ .env.local-ыг git-д ХЭЗЭЭ Ч commit хийхгүй (.gitignore-д бүртгэлтэй).
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
# SUPABASE  (Phase 2-оос шаардлагатай)
#
# Хаанаас авах:
#   1. https://supabase.com → New project
#   2. Project Settings → API
#   3. "Project URL" ба "anon public" түлхүүрийг доор буулгана
# ────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ SERVICE ROLE түлхүүр — RLS-ыг БҮРЭН ТОЙРДОГ.
#    • Зөвхөн серверийн орчинд ашиглана
#    • NEXT_PUBLIC_ угтвар ХЭРЭГЛЭХГҮЙ
#    • Vercel дээр Environment Variables хэсэгт нэмнэ (Production/Preview)
#    • Хэн нэгэнд илгээх, чатад бичих, screenshot авахгүй
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...


# ────────────────────────────────────────────────────────────────────────────
# OPENAI  (AI түүхийн багш)
#
# Хаанаас авах: https://platform.openai.com/api-keys
#
# Тохируулаагүй бол AI багш нь системийн мэдлэгийн сангаас автоматаар
# хариулт эмхэтгэнэ (алдаа гарахгүй, зүгээр л ярианы горим хязгаарлагдмал).
# ────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini


# ────────────────────────────────────────────────────────────────────────────
# SEED  (демо өгөгдлийг Supabase руу бичих)
#
# Өөрөө санамсаргүй урт тэмдэгт зохиож тавина. Жишээ:
#   openssl rand -hex 24
#
# Ажиллуулах:
#   curl -X POST http://localhost:3000/api/admin/seed \
#        -H "x-seed-secret: <SEED_SECRET>"
#
# Seed хийж дуусаад энэ хувьсагчийг устгахыг зөвлөнө.
# Тохируулаагүй бол /api/admin/seed route идэвхгүй байна.
# ────────────────────────────────────────────────────────────────────────────

SEED_SECRET=


# ────────────────────────────────────────────────────────────────────────────
# САЙТ
#
# sitemap.xml, robots.txt, Open Graph-д ашиглагдана.
# Vercel дээр production домэйноо бичнэ: https://tuuhee-medye.vercel.app
# ────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# БАГШИЙН УРИЛГЫН КОД
#
# Багшаар бүртгүүлэхэд шаардагдана. Зөвхөн серверт байна (NEXT_PUBLIC_ биш).
# Сургуулийн багш нартаа энэ кодыг өгнө.
#
# Админ эрхийг ЭНЭ ЗАМААР олгохгүй - зөвхөн SQL-ээр:
#   update public.profiles set role = 'admin' where email = '...';
# ----------------------------------------------------------------------------

TEACHER_INVITE_CODE=